<!DOCTYPE html>
<html>
<head>
    <title>Listings - SkillConnect</title>

<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;600&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">

<style>

*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

:root {
--bg:#1a1625;
--surface:#221d2e;
--card:#2a2438;
--border:rgba(255,255,255,0.08);
--accent:#c8a96e;
--accent-dim:rgba(200,169,110,0.10);
--text:#f0ece4;
--muted:#8a8499;
}

body{
font-family:'DM Sans',sans-serif;
background:var(--bg);
color:var(--text);
min-height:100vh;
}

body::before{
content:'';
position:fixed;
top:-150px;
right:-150px;
width:500px;
height:500px;
background:radial-gradient(circle, rgba(200,169,110,0.05) 0%, transparent 70%);
pointer-events:none;
z-index:0;
}

/* NAVBAR */

.navbar{
display:flex;
align-items:center;
justify-content:space-between;
padding:22px 48px;
border-bottom:1px solid var(--border);
background:var(--surface);
position:relative;
z-index:100;
}

.navbar-brand{
font-family:'Playfair Display',serif;
font-size:1.4rem;
font-weight:600;
color:var(--text);
text-decoration:none;
}

.navbar-brand span{ color:var(--accent); }

.navbar-links{
display:flex;
align-items:center;
gap:18px;
}

.nav-link{
color:var(--muted);
text-decoration:none;
font-size:0.875rem;
padding:8px 16px;
border-radius:6px;
transition:0.2s;
}

.nav-link:hover{
color:var(--text);
background:rgba(255,255,255,0.04);
}

.nav-link.teach{
color:var(--accent);
border:1px solid rgba(200,169,110,0.25);
background:rgba(200,169,110,0.06);
}

.nav-link.logout{
color:#e07070;
}

/* PAGE */

.page-wrapper{
position:relative;
z-index:1;
max-width:1200px;
margin:0 auto;
padding:48px 32px;
}

.page-header{
display:flex;
justify-content:space-between;
align-items:flex-end;
margin-bottom:40px;
}

.eyebrow{
font-size:0.72rem;
font-weight:500;
letter-spacing:0.12em;
text-transform:uppercase;
color:var(--accent);
margin-bottom:8px;
}

.page-header h2{
font-family:'Playfair Display',serif;
font-size:2rem;
font-weight:500;
}

/* GRID */

.listings-grid{
display:grid;
grid-template-columns:repeat(auto-fill,minmax(300px,1fr));
gap:24px;
}

/* CARD */

.tutor-card{
background:var(--card);
border:1px solid var(--border);
border-radius:14px;
padding:28px;
display:flex;
flex-direction:column;
gap:16px;
transition:0.2s;
}

.tutor-card:hover{
transform:translateY(-4px);
border-color:rgba(200,169,110,0.25);
box-shadow:0 12px 40px rgba(0,0,0,0.3);
}

.card-avatar{
width:44px;
height:44px;
border-radius:50%;
background:var(--accent-dim);
border:1px solid rgba(200,169,110,0.2);
display:flex;
align-items:center;
justify-content:center;
font-family:'Playfair Display',serif;
font-size:1.1rem;
color:var(--accent);
}

.card-name{
font-family:'Playfair Display',serif;
font-size:1.15rem;
}

.card-meta{
display:flex;
flex-direction:column;
gap:8px;
}

.meta-row{
display:flex;
gap:10px;
font-size:0.875rem;
}

.meta-label{
font-size:0.72rem;
text-transform:uppercase;
color:var(--muted);
width:44px;
}

.meta-value{ color:var(--text); }

.level-badge{
display:inline-block;
padding:3px 10px;
border-radius:20px;
font-size:0.75rem;
background:var(--accent-dim);
color:var(--accent);
border:1px solid rgba(200,169,110,0.2);
}

.card-divider{
height:1px;
background:var(--border);
}

.btn-view{
display:inline-flex;
align-items:center;
gap:6px;
padding:10px 18px;
background:transparent;
border:1px solid var(--border);
border-radius:7px;
color:var(--muted);
font-size:0.85rem;
text-decoration:none;
}

.btn-view:hover{
color:var(--text);
border-color:rgba(200,169,110,0.35);
background:var(--accent-dim);
}

</style>
</head>

<body>

<nav class="navbar">

<a href="/listings" class="navbar-brand">Skill<span>Connect</span></a>

<div class="navbar-links">
<a href="/listings" class="nav-link">Listings</a>
<a href="/listings/new" class="nav-link teach">Teach a Skill</a>
<a href="/logout" class="nav-link logout">Logout</a>
</div>

</nav>

<div class="page-wrapper">

<div class="page-header">
<div>
<div class="eyebrow">Discover</div>
<h2>Available Tutors</h2>
</div>

<a href="/listings/new" class="nav-link teach">Teach a Skill</a>
</div>

<div class="listings-grid">
<% allListings.forEach(listing => { %>

<div class="tutor-card">

<div class="card-name">
<%= listing.name ? listing.name.charAt(0).toUpperCase() + listing.name.slice(1) : "Unknown" %>
</div>

<div class="card-meta">

<div class="meta-row">
<span class="meta-label">Skill</span>
<span class="meta-value"><%= listing.skill %></span>
</div>

<div class="meta-row">
<span class="meta-label">Level</span>
<span class="level-badge"><%= listing.level %></span>
</div>

</div>

<div class="card-divider"></div>

<a href="/listings/<%= listing._id %>" class="btn-view">
View Details →
</a>

</div>

<% }) %>

</div>

</div>

</body>
</html>