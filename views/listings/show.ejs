<!DOCTYPE html>
<html>

<head>

<title>Tutor Details - SkillConnect</title>

<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;600&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">

<style>

*, *::before, *::after{ box-sizing:border-box; margin:0; padding:0; }

:root{
--bg:#1a1625;
--surface:#221d2e;
--card:#2a2438;
--border:rgba(255,255,255,0.08);
--accent:#c8a96e;
--accent-dim:rgba(200,169,110,0.10);
--text:#f0ece4;
--muted:#8a8499;
}

body{
font-family:'DM Sans',sans-serif;
background:var(--bg);
color:var(--text);
min-height:100vh;
}

.container{
max-width:700px;
margin:60px auto;
padding:0 20px;
}

.box{
background:var(--surface);
border:1px solid var(--border);
border-radius:16px;
padding:35px;
margin-bottom:30px;
}

h2{
font-family:'Playfair Display',serif;
text-align:center;
margin-bottom:20px;
}

.info p{
margin-bottom:10px;
font-size:0.9rem;
}

.badge{
background:var(--accent-dim);
color:var(--accent);
padding:4px 10px;
border-radius:20px;
font-size:0.75rem;
border:1px solid rgba(200,169,110,0.2);
}

hr{
border:none;
border-top:1px solid var(--border);
margin:20px 0;
}

.buttons{
display:flex;
gap:10px;
margin-top:25px;
}

.btn{
padding:10px 16px;
border-radius:8px;
border:none;
cursor:pointer;
font-size:0.85rem;
text-decoration:none;
display:inline-block;
font-family:'DM Sans',sans-serif;
}

.btn-primary{
background:var(--accent);
color:#1a1625;
}

.btn-secondary{
background:transparent;
border:1px solid var(--border);
color:var(--muted);
}

.btn-danger{
background:#a54444;
color:white;
}

.btn-warning{
background:#c8a96e;
color:#1a1625;
}

.btn-success{
background:#2e8b57;
color:white;
}

.btn:hover{
opacity:0.9;
}

/* Reviews */

.review-card{
background:var(--card);
border:1px solid var(--border);
border-radius:10px;
padding:15px;
margin-bottom:10px;
}

.review-stars{
color:gold;
margin:5px 0;
}

.review-author{
color:var(--accent);
font-weight:500;
display:block;
margin-bottom:3px;
}

textarea{
width:100%;
padding:10px;
border-radius:8px;
border:1px solid var(--border);
background:rgba(255,255,255,0.04);
color:var(--text);
margin-top:5px;
margin-bottom:15px;
}

label{
font-size:0.8rem;
color:var(--muted);
}

#starRating span{
font-size:28px;
cursor:pointer;
}

.flash{
padding:10px;
border-radius:8px;
margin-bottom:15px;
font-size:0.85rem;
}

.flash-success{
background:rgba(80,200,120,0.08);
color:#80e0a0;
}

.flash-error{
background:rgba(255,80,80,0.08);
color:#ff9090;
}

</style>

</head>

<body>

<%- include("../includes/navbar") %>

<div class="container">

<!-- Flash Messages -->

<% if(success && success.length > 0){ %>
<div class="flash flash-success">
<%= success %>
</div>
<% } %>

<% if(error && error.length > 0){ %>
<div class="flash flash-error">
<%= error %>
</div>
<% } %>


<!-- Tutor Details -->

<div class="box">

<h2>
<%= listing.name ? listing.name.charAt(0).toUpperCase() + listing.name.slice(1) : "Unknown" %>
</h2>

<div class="info">

<p><strong>Name:</strong>
<%= listing.name ? listing.name.charAt(0).toUpperCase() + listing.name.slice(1) : "Unknown" %>
</p>

<p><strong>Skill:</strong> <%= listing.skill %></p>

<p><strong>Description:</strong> <%= listing.description %></p>

<p>
<strong>Level:</strong>
<span class="badge"><%= listing.level %></span>
</p>

</div>

<hr>

<!-- Hide connect if owner -->

<% if(currentUser && listing.owner && currentUser._id.toString() !== listing.owner._id.toString()) { %>

<form action="/listings/<%= listing._id %>/connect" method="POST" style="margin-bottom:20px;">
<button class="btn btn-primary">
Connect with Tutor
</button>
</form>

<% } %>

<div class="buttons">

<!-- Owner Controls -->

<% if(currentUser && listing.owner && currentUser._id.toString() === listing.owner._id.toString()) { %>

<a href="/listings/<%= listing._id %>/edit" class="btn btn-warning">
Edit
</a>

<form action="/listings/<%= listing._id %>?_method=DELETE" method="POST">
<button class="btn btn-danger">
Delete
</button>
</form>

<% } %>

</div>

<a href="/listings" class="btn btn-secondary" style="margin-top:15px;">
Back to Listings
</a>

</div>


<!-- Reviews Section -->

<div class="box">

<h3 style="margin-bottom:15px;">Reviews</h3>

<form action="/listings/<%= listing._id %>/reviews" method="POST">

<label>Rating</label>

<div id="starRating">
<span data-value="1">☆</span>
<span data-value="2">☆</span>
<span data-value="3">☆</span>
<span data-value="4">☆</span>
<span data-value="5">☆</span>
</div>

<input type="hidden" name="rating" id="ratingValue" required>

<label>Comment</label>

<textarea name="comment" required></textarea>

<button class="btn btn-success">
Submit Review
</button>

</form>

<hr>

<!-- Display Reviews -->

<% if(listing.reviews.length === 0){ %>
<p>No reviews yet.</p>
<% } %>

<% for(let review of listing.reviews){ %>

<div class="review-card">

<span class="review-author">
<%= review.author ? review.author.username : "Anonymous" %>
</span>

<div class="review-stars">

<% for(let i=0;i<review.rating;i++){ %>
⭐
<% } %>

</div>

<p><%= review.comment %></p>

</div>

<% } %>

</div>

</div>


<script>

const stars = document.querySelectorAll("#starRating span");
const ratingInput = document.getElementById("ratingValue");

stars.forEach((star,index)=>{

star.addEventListener("click",()=>{

ratingInput.value = star.dataset.value;

stars.forEach((s,i)=>{

if(i<=index){
s.textContent="⭐";
}else{
s.textContent="☆";
}

});

});

});

</script>

</body>
</html>