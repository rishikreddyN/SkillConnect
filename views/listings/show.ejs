<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Tutor Details - SkillConnect</title>
  <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;700;800&family=DM+Mono:wght@400;500&family=DM+Sans:ital,wght@0,300;0,400;1,300&display=swap" rel="stylesheet"/>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    html, body, a, button, input, textarea, select, [role="button"] { cursor: none !important; }

    :root {
      --bg:      #0a0a0f;
      --surface: #12121a;
      --card:    #16161f;
      --border:  rgba(255,255,255,0.07);
      --accent:  #00e5a0;
      --accent2: #7b61ff;
      --text:    #f0f0f8;
      --muted:   #6b6b80;
    }

    html { scroll-behavior: smooth; }

    body {
      background: var(--bg);
      color: var(--text);
      font-family: 'DM Sans', sans-serif;
      font-weight: 300;
      min-height: 100vh;
      overflow-x: hidden;
    }

    ::-webkit-scrollbar { width: 4px; }
    ::-webkit-scrollbar-track { background: var(--bg); }
    ::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.1); border-radius: 2px; }

    body::before {
      content: '';
      position: fixed;
      inset: 0;
      background-image:
        linear-gradient(rgba(255,255,255,0.025) 1px, transparent 1px),
        linear-gradient(90deg, rgba(255,255,255,0.025) 1px, transparent 1px);
      background-size: 60px 60px;
      pointer-events: none;
      z-index: 0;
    }

    .blob {
      position: fixed;
      border-radius: 50%;
      filter: blur(120px);
      pointer-events: none;
      z-index: 0;
      opacity: 0.15;
    }
    .blob-1 {
      width: 600px; height: 600px;
      background: var(--accent2);
      top: -200px; right: -100px;
      animation: blobFloat1 12s ease-in-out infinite;
    }
    .blob-2 {
      width: 500px; height: 500px;
      background: var(--accent);
      bottom: -150px; left: -100px;
      animation: blobFloat2 15s ease-in-out infinite;
    }
    @keyframes blobFloat1 {
      0%, 100% { transform: translate(0,0) scale(1); }
      50% { transform: translate(-40px,60px) scale(1.1); }
    }
    @keyframes blobFloat2 {
      0%, 100% { transform: translate(0,0) scale(1); }
      50% { transform: translate(50px,-40px) scale(1.08); }
    }

    /* Cursor */
    .cursor {
      width: 10px; height: 10px;
      background: var(--accent);
      border-radius: 50%;
      position: fixed; top: 0; left: 0;
      pointer-events: none;
      z-index: 9999;
      transform: translate(-50%, -50%);
      transition: width 0.3s, height 0.3s;
      mix-blend-mode: screen;
    }
    .cursor-ring {
      width: 36px; height: 36px;
      border: 1px solid rgba(0,229,160,0.4);
      border-radius: 50%;
      position: fixed; top: 0; left: 0;
      pointer-events: none;
      z-index: 9998;
      transform: translate(-50%, -50%);
      transition: width 0.3s, height 0.3s, border-color 0.3s;
    }

    /* ===== NAVBAR ===== */
    nav {
      position: fixed;
      top: 0; left: 0; right: 0;
      z-index: 100;
      padding: 18px 48px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      border-bottom: 1px solid var(--border);
      background: rgba(10,10,15,0.85);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
    }

    .logo {
      font-family: 'Syne', sans-serif;
      font-weight: 800;
      font-size: 22px;
      letter-spacing: -0.5px;
      color: var(--text);
      text-decoration: none;
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .logo-dot {
      width: 8px; height: 8px;
      background: var(--accent);
      border-radius: 50%;
      flex-shrink: 0;
      animation: pulse 2s ease-in-out infinite;
    }
    @keyframes pulse {
      0%, 100% { box-shadow: 0 0 0 0 rgba(0,229,160,0.5); }
      50%       { box-shadow: 0 0 0 6px rgba(0,229,160,0); }
    }

    .nav-right { display: flex; align-items: center; gap: 8px; }

    .nav-link {
      color: var(--muted);
      text-decoration: none;
      font-size: 14px;
      padding: 8px 16px;
      border-radius: 4px;
      letter-spacing: 0.02em;
      transition: color 0.2s, background 0.2s;
    }
    .nav-link:hover { color: var(--text); background: rgba(255,255,255,0.04); }

    .nav-link.teach {
      font-family: 'DM Mono', monospace;
      font-size: 13px;
      color: var(--accent);
      border: 1px solid rgba(0,229,160,0.3);
      background: rgba(0,229,160,0.06);
    }
    .nav-link.teach:hover {
      background: var(--accent);
      color: #000;
      border-color: var(--accent);
      box-shadow: 0 0 20px rgba(0,229,160,0.25);
    }

    .nav-link.logout {
      color: #ff7070;
      border: 1px solid rgba(255,112,112,0.2);
    }
    .nav-link.logout:hover {
      background: rgba(255,112,112,0.08);
      color: #ff9090;
      border-color: rgba(255,112,112,0.35);
    }

    .hamburger {
      display: none;
      flex-direction: column;
      gap: 5px;
      background: none;
      border: none;
      padding: 4px;
    }
    .hamburger span {
      display: block;
      width: 22px; height: 2px;
      background: var(--text);
      border-radius: 2px;
      transition: transform 0.3s, opacity 0.3s;
    }
    .hamburger.open span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
    .hamburger.open span:nth-child(2) { opacity: 0; }
    .hamburger.open span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

    .mobile-menu {
      display: none;
      position: fixed;
      top: 61px; left: 0; right: 0;
      background: rgba(10,10,15,0.97);
      backdrop-filter: blur(20px);
      border-bottom: 1px solid var(--border);
      z-index: 99;
      padding: 16px 20px 24px;
      flex-direction: column;
      gap: 4px;
    }
    .mobile-menu.open { display: flex; }
    .mobile-menu a {
      color: var(--muted);
      text-decoration: none;
      font-size: 15px;
      padding: 12px 0;
      border-bottom: 1px solid var(--border);
      transition: color 0.2s;
    }
    .mobile-menu a:last-child { border-bottom: none; }
    .mobile-menu a:hover { color: var(--text); }
    .mobile-menu a.teach { color: var(--accent); }
    .mobile-menu a.logout { color: #ff7070; }

    /* ===== PAGE ===== */
    .page-wrapper {
      position: relative;
      z-index: 1;
      max-width: 700px;
      margin: 0 auto;
      padding: 108px 24px 60px;
    }

    /* ===== FLASH ===== */
    .flash {
      padding: 13px 16px;
      border-radius: 6px;
      font-size: 14px;
      margin-bottom: 20px;
      border: 1px solid;
      animation: fadeIn 0.3s ease;
    }
    @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
    .flash-success {
      background: rgba(0,229,160,0.08);
      border-color: rgba(0,229,160,0.2);
      color: var(--accent);
    }
    .flash-error {
      background: rgba(255,80,80,0.08);
      border-color: rgba(255,80,80,0.2);
      color: #ff9090;
    }

    /* ===== CARD ===== */
    .card {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 36px;
      margin-bottom: 20px;
      position: relative;
      overflow: hidden;
      animation: fadeUp 0.6s cubic-bezier(0.16,1,0.3,1) both;
    }
    .card::before {
      content: '';
      position: absolute;
      top: -1px; left: 15%; right: 15%;
      height: 1px;
      background: linear-gradient(90deg, transparent, var(--accent), transparent);
      pointer-events: none;
    }
    .card::after {
      content: '';
      position: absolute;
      inset: 0;
      background: radial-gradient(ellipse 70% 35% at 50% 0%, rgba(0,229,160,0.04), transparent);
      pointer-events: none;
    }
    .card.reviews-card { animation-delay: 0.1s; }

    @keyframes fadeUp {
      from { opacity: 0; transform: translateY(20px); }
      to   { opacity: 1; transform: translateY(0); }
    }

    /* ===== TUTOR HEADER ===== */
    .tutor-header {
      display: flex;
      align-items: center;
      gap: 18px;
      margin-bottom: 28px;
    }

    .tutor-avatar {
      width: 60px; height: 60px;
      border-radius: 50%;
      background: linear-gradient(135deg, var(--accent2), var(--accent));
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: 'Syne', sans-serif;
      font-weight: 800;
      font-size: 22px;
      color: #fff;
      flex-shrink: 0;
    }

   
    .tutor-eyebrow {
      font-family: 'DM Mono', monospace;
      font-size: 10px;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: var(--accent);
      margin-bottom: 6px;
    }
    .tutor-name {
      font-family: 'Syne', sans-serif;
      font-weight: 800;
      font-size: 28px;
      letter-spacing: -0.02em;
      line-height: 1;
    }

    /* ===== INFO ROWS ===== */
    .divider { height: 1px; background: var(--border); margin: 24px 0; }

    .info-grid {
      display: flex;
      flex-direction: column;
      gap: 14px;
    }

    .info-row {
      display: flex;
      gap: 12px;
      align-items: flex-start;
      font-size: 14px;
    }

    .info-label {
      font-family: 'DM Mono', monospace;
      font-size: 10px;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--muted);
      width: 88px;
      flex-shrink: 0;
      padding-top: 2px;
    }

    .info-value { color: var(--text); font-weight: 300; line-height: 1.6; }

    .level-badge {
      display: inline-block;
      padding: 3px 10px;
      border-radius: 3px;
      font-family: 'DM Mono', monospace;
      font-size: 11px;
      font-weight: 500;
      background: rgba(0,229,160,0.08);
      color: var(--accent);
      border: 1px solid rgba(0,229,160,0.2);
    }

    /* ===== BUTTONS ===== */
    .action-buttons {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      margin-top: 24px;
      position: relative;
      z-index: 2;
    }

    .btn {
      padding: 11px 20px;
      border-radius: 6px;
      border: none;
      font-family: 'Syne', sans-serif;
      font-size: 14px;
      font-weight: 700;
      letter-spacing: 0.02em;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      transition: transform 0.2s, box-shadow 0.2s, opacity 0.2s;
      -webkit-tap-highlight-color: transparent;
      position: relative;
      z-index: 2;
    }
    .btn:active { transform: scale(0.97); }

    .btn-connect {
      background: var(--accent);
      color: #000;
      width: 100%;
      padding: 13px;
      margin-bottom: 16px;
      font-size: 15px;
    }
    .btn-connect:hover { box-shadow: 0 0 28px rgba(0,229,160,0.35); transform: translateY(-1px); }

    .btn-edit {
      background: rgba(123,97,255,0.15);
      color: #a78bfa;
      border: 1px solid rgba(123,97,255,0.25);
    }
    .btn-edit:hover { background: rgba(123,97,255,0.25); }

    .btn-delete {
      background: rgba(255,80,80,0.1);
      color: #ff9090;
      border: 1px solid rgba(255,80,80,0.2);
    }
    .btn-delete:hover { background: rgba(255,80,80,0.18); }

    .btn-back {
      background: transparent;
      border: 1px solid var(--border);
      color: var(--muted);
      font-family: 'DM Mono', monospace;
      font-size: 12px;
      font-weight: 500;
      margin-top: 4px;
    }
    .btn-back:hover { border-color: rgba(255,255,255,0.2); color: var(--text); }

    /* ===== REVIEWS ===== */
    .section-title {
      font-family: 'Syne', sans-serif;
      font-weight: 800;
      font-size: 22px;
      letter-spacing: -0.02em;
      margin-bottom: 24px;
    }

    /* Star rating */
    .star-label {
      font-family: 'DM Mono', monospace;
      font-size: 11px;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--muted);
      margin-bottom: 8px;
      display: block;
    }

    #starRating {
      display: flex;
      gap: 4px;
      margin-bottom: 20px;
    }
    #starRating span {
      font-size: 28px;
      line-height: 1;
      transition: transform 0.1s;
      color: var(--muted);
    }
    #starRating span:hover { transform: scale(1.2); }
    #starRating span.filled { color: #f59e0b; }

    .field { margin-bottom: 20px; }

    label {
      display: block;
      font-family: 'DM Mono', monospace;
      font-size: 11px;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--muted);
      margin-bottom: 8px;
    }

    textarea {
      width: 100%;
      padding: 13px 16px;
      background: rgba(255,255,255,0.04);
      border: 1px solid var(--border);
      border-radius: 6px;
      color: var(--text);
      font-family: 'DM Sans', sans-serif;
      font-size: max(16px, 15px);
      font-weight: 300;
      outline: none;
      resize: none;
      transition: border-color 0.2s, background 0.2s, box-shadow 0.2s;
    }
    textarea::placeholder { color: var(--muted); }
    textarea:focus {
      border-color: var(--accent);
      background: rgba(0,229,160,0.05);
      box-shadow: 0 0 0 3px rgba(0,229,160,0.08);
    }

    .btn-submit-review {
      background: var(--accent);
      color: #000;
      padding: 12px 24px;
      font-size: 14px;
    }
    .btn-submit-review:hover { box-shadow: 0 0 24px rgba(0,229,160,0.3); transform: translateY(-1px); }

    /* Review cards */
    .reviews-list { margin-top: 28px; display: flex; flex-direction: column; gap: 12px; }

    .review-card {
      background: rgba(255,255,255,0.02);
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 16px 20px;
      transition: border-color 0.2s;
    }
    .review-card:hover { border-color: rgba(0,229,160,0.15); }

    .review-top {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 8px;
      gap: 8px;
    }

    .review-author {
      font-family: 'Syne', sans-serif;
      font-weight: 700;
      font-size: 14px;
      color: var(--accent);
    }

    .review-stars { font-size: 14px; letter-spacing: 1px; }

    .review-comment { font-size: 14px; color: var(--muted); line-height: 1.6; font-weight: 300; }

    .no-reviews {
      font-family: 'DM Mono', monospace;
      font-size: 12px;
      letter-spacing: 0.08em;
      color: var(--muted);
      text-align: center;
      padding: 24px 0 8px;
    }

    /* ============================================================
       RESPONSIVE
    ============================================================ */

    @media (max-width: 1024px) {
      nav { padding: 18px 28px; }
      .nav-links-desktop { display: none; }
      .hamburger { display: flex; }
      .page-wrapper { padding: 96px 20px 60px; }
    }

    @media (max-width: 640px) {
      html, body, a, button, input, textarea, select, [role="button"] { cursor: auto !important; }
      .cursor, .cursor-ring { display: none; }

      nav { padding: 16px 20px; }
      .logo { font-size: 18px; }
      .mobile-menu { top: 57px; }

      .page-wrapper { padding: 80px 16px 48px; }

      .card { padding: 24px 20px; }

      .tutor-avatar { width: 48px; height: 48px; font-size: 18px; }
      .tutor-name { font-size: 22px; }

      .info-row { flex-direction: column; gap: 4px; }
      .info-label { width: auto; }

      .action-buttons { flex-direction: column; }
      .btn { width: 100%; }

      .section-title { font-size: 18px; }
      #starRating span { font-size: 32px; }

      .review-top { flex-direction: column; align-items: flex-start; }
    }
  </style>
</head>
<body>

  <div class="cursor" id="cursor"></div>
  <div class="cursor-ring" id="cursorRing"></div>

  <div class="blob blob-1"></div>
  <div class="blob blob-2"></div>

  <!-- Navbar -->
  <nav>
    <a href="/listings" class="logo">
      <span class="logo-dot"></span>
      SkillConnect
    </a>
    <div class="nav-right nav-links-desktop">
      <a href="/listings" class="nav-link">Listings</a>
      <a href="/listings/new" class="nav-link teach">Teach a Skill</a>
      <a href="/logout" class="nav-link logout">Logout</a>
    </div>
    <button class="hamburger" id="hamburger" aria-label="Toggle menu">
      <span></span><span></span><span></span>
    </button>
  </nav>

  <!-- Mobile Menu -->
  <div class="mobile-menu" id="mobileMenu">
    <a href="/listings">Listings</a>
    <a href="/listings/new" class="teach">Teach a Skill</a>
    <a href="/logout" class="logout">Logout</a>
  </div>

  <div class="page-wrapper">

    <!-- Flash Messages -->
    <% if(success && success.length > 0){ %>
      <div class="flash flash-success"><%= success %></div>
    <% } %>
    <% if(error && error.length > 0){ %>
      <div class="flash flash-error"><%= error %></div>
    <% } %>

    <!-- Tutor Details Card -->
    <div class="card">

      <div class="tutor-header">
        <div class="tutor-avatar">
          <%= listing.name ? listing.name.charAt(0).toUpperCase() : "?" %>
        </div>
        <div class="tutor-header-text">
          <div class="tutor-eyebrow">Tutor Profile</div>
          <div class="tutor-name">
            <%= listing.name ? listing.name.charAt(0).toUpperCase() + listing.name.slice(1) : "Unknown" %>
          </div>
        </div>
      </div>

      <div class="info-grid">
        <div class="info-row">
          <span class="info-label">Skill</span>
          <span class="info-value"><%= listing.skill %></span>
        </div>
        <div class="info-row">
          <span class="info-label">Description</span>
          <span class="info-value"><%= listing.description %></span>
        </div>
        <div class="info-row">
          <span class="info-label">Level</span>
          <span class="info-value"><span class="level-badge"><%= listing.level %></span></span>
        </div>
      </div>

      <div class="divider"></div>

<!-- Connect button — hidden for owner -->
<% if(currentUser && listing.owner && currentUser._id.toString() !== listing.owner._id.toString()) { %>
  <% if(existingRequest) { %>
    <% if(existingRequest.status === "accepted") { %>
    <p class="btn btn-connect" style="background:rgba(0,229,160,0.1); color:var(--accent); text-align:center;">✅ Request Accepted</p>
    <a href="/chats" style="display:block; width:100%; padding:13px; margin-top:10px; background:#00e5a0; color:#000; text-align:center; border-radius:6px; font-weight:700; text-decoration:none; font-size:15px;">
        💬 Go to Chat
    </a>
    <% } else if(existingRequest.status === "declined") { %>
      <p class="btn btn-connect" style="background:rgba(255,80,80,0.1); color:#ff9090; text-align:center;">❌ Request Declined</p>
    <% } else { %>
      <p class="btn btn-connect" style="background:rgba(255,255,255,0.05); color:var(--muted); text-align:center;">⏳ Request Pending...</p>
    <% } %>
  <% } else { %>
    <form action="/listings/<%= listing._id %>/connect" method="POST">
      <button class="btn btn-connect">
        Connect with Tutor
        <svg width="15" height="15" viewBox="0 0 16 16" fill="none">
          <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
    </form>
  <% } %>
<% } %>
      <!-- Owner controls -->
      <div class="action-buttons">
        <% if(currentUser && listing.owner && currentUser._id.toString() === listing.owner._id.toString()) { %>
          <a href="/listings/<%= listing._id %>/edit" class="btn btn-edit">
            ✏️ Edit Listing
          </a>
          <form action="/listings/<%= listing._id %>?_method=DELETE" method="POST">
            <button class="btn btn-delete">🗑 Delete</button>
          </form>
        <% } %>
        <a href="/listings" class="btn btn-back">← Back to Listings</a>
      </div>

    </div>

    <!-- Reviews Card -->
    <div class="card reviews-card">

      <div class="section-title">Reviews</div>

      <form action="/listings/<%= listing._id %>/reviews" method="POST">

        <div class="field">
          <span class="star-label">Rating</span>
          <div id="starRating">
            <span data-value="1">☆</span>
            <span data-value="2">☆</span>
            <span data-value="3">☆</span>
            <span data-value="4">☆</span>
            <span data-value="5">☆</span>
          </div>
          <input type="hidden" name="rating" id="ratingValue" required />
        </div>

        <div class="field">
          <label for="comment">Comment</label>
          <textarea id="comment" name="comment" rows="3" placeholder="Share your experience..." required></textarea>
        </div>

        <button type="submit" class="btn btn-submit-review">Submit Review</button>

      </form>

      <div class="divider"></div>

      <!-- Display reviews -->
      <% if(listing.reviews.length === 0){ %>
        <p class="no-reviews">No reviews yet — be the first!</p>
      <% } %>

      <div class="reviews-list">
        <% for(let review of listing.reviews){ %>
          <div class="review-card">
            <div class="review-top">
              <span class="review-author">
                <%= review.author ? review.author.username : "Anonymous" %>
              </span>
              <div class="review-stars">
                <% for(let i = 0; i < review.rating; i++){ %>⭐<% } %>
              </div>
            </div>
            <p class="review-comment"><%= review.comment %></p>
          </div>
        <% } %>
      </div>

    </div>

  </div>

  <script>
    // Cursor
    const cursor = document.getElementById('cursor');
    const ring = document.getElementById('cursorRing');
    let mx = 0, my = 0, rx = 0, ry = 0;

    document.addEventListener('mousemove', e => {
      mx = e.clientX; my = e.clientY;
      cursor.style.left = mx + 'px';
      cursor.style.top = my + 'px';
    });

    (function animateRing() {
      rx += (mx - rx) * 0.12;
      ry += (my - ry) * 0.12;
      ring.style.left = rx + 'px';
      ring.style.top = ry + 'px';
      requestAnimationFrame(animateRing);
    })();

    document.querySelectorAll('a, button, input, textarea, select').forEach(el => {
      el.addEventListener('mouseenter', () => {
        cursor.style.width = '20px'; cursor.style.height = '20px';
        ring.style.width = '52px'; ring.style.height = '52px';
        ring.style.borderColor = 'rgba(0,229,160,0.6)';
      });
      el.addEventListener('mouseleave', () => {
        cursor.style.width = '10px'; cursor.style.height = '10px';
        ring.style.width = '36px'; ring.style.height = '36px';
        ring.style.borderColor = 'rgba(0,229,160,0.4)';
      });
    });

    // Hamburger
    const hamburger = document.getElementById('hamburger');
    const mobileMenu = document.getElementById('mobileMenu');
    hamburger.addEventListener('click', () => {
      hamburger.classList.toggle('open');
      mobileMenu.classList.toggle('open');
    });
    mobileMenu.querySelectorAll('a').forEach(a => {
      a.addEventListener('click', () => {
        hamburger.classList.remove('open');
        mobileMenu.classList.remove('open');
      });
    });

    // Star rating
    const stars = document.querySelectorAll('#starRating span');
    const ratingInput = document.getElementById('ratingValue');

    stars.forEach((star, index) => {
      star.addEventListener('click', () => {
        ratingInput.value = star.dataset.value;
        stars.forEach((s, i) => {
          s.textContent = i <= index ? '⭐' : '☆';
          s.classList.toggle('filled', i <= index);
        });
      });

      star.addEventListener('mouseenter', () => {
        stars.forEach((s, i) => {
          s.textContent = i <= index ? '⭐' : '☆';
        });
      });

      star.addEventListener('mouseleave', () => {
        const current = parseInt(ratingInput.value) || 0;
        stars.forEach((s, i) => {
          s.textContent = i < current ? '⭐' : '☆';
        });
      });
    });
  </script>

</body>
</html>
